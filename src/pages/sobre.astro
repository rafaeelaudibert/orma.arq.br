---
import { Image } from "astro:assets"

import opening from "../assets/projects/apartamento-br/01-bedroom.jpg"
import { partnerNames, studio } from "../config"
import { openingSizes, PHOTO_WIDTHS } from "../lib/images"
import Layout from "../layouts/Layout.astro"

/** The three words she set across the top of the page. */
const promise = ["Forma", "Reforma", "Transforma"]
---

<Layout
  title="Sobre nós"
  description={`${studio.name} é um estúdio de arquitetura e interiores em ${studio.city}. Projetos residenciais e comerciais em ${studio.regions.join(" e ")}.`}
  flush
>
  <h1 class="visually-hidden">Sobre nós — {studio.name}</h1>

  <section class="story">
    <div class="column">
      <p class="promise" data-reveal>
        {promise.map((word) => <span>{word}</span>)}
      </p>

      <p class="prose" data-reveal style="--stagger: 1">
        Nossa história começou há 10 anos, no primeiro dia de faculdade e nos
        aproximou a cada projeto em grupo para uma amizade duradoura que vai
        além do profissional. Somos <strong>{partnerNames[0]}</strong> e <strong
          >{partnerNames[1]}</strong
        >, duas arquitetas formadas pela UFRGS com uma obsessão por detalhe e um
        fascínio por espaços funcionais e belos, principalmente se tratando de
        criar o lugar do sonho de cada cliente, onde se vai morar e criar
        memórias. Somos um escritório surgido da vontade de atuarmos juntas em
        projetos que acreditamos, com o propósito de proporcionar conforto,
        segurança, harmonia e paz, seja visualmente ou sensorialmente.
      </p>
    </div>
  </section>

  <figure class="portrait">
    <Image
      src={opening}
      alt="Corredor com armários de madeira escura do piso ao teto e luminária de chão redonda"
      widths={PHOTO_WIDTHS}
      sizes={openingSizes(opening)}
      loading="eager"
      fetchpriority="high"
    />
  </figure>
</Layout>

<style>
  /* Two screens: the words and the story, then one photograph. */
  .story,
  .portrait {
    --screen: calc(100svh - var(--header-height) - var(--edge));
  }

  .story {
    display: grid;
    place-items: center;
    padding: var(--space-6) var(--gutter);
  }

  .column {
    inline-size: 100%;
    max-inline-size: 56rem;
  }

  .promise {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
    margin-block-end: var(--space-5);
    font-size: var(--text-ui);
  }

  .prose {
    font-size: var(--text-ui);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .prose strong {
    font-weight: 700;
  }

  .portrait {
    margin: var(--edge) 0 0;
    overflow: clip;
    background: var(--color-grey-2);
  }

  .portrait img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 60rem) {
    .story,
    .portrait {
      block-size: var(--screen);
    }

    .story {
      padding-block: 0;
    }

    .portrait img {
      aspect-ratio: auto;
    }

    .prose {
      text-align: justify;
    }
  }
</style>
