---
import { Picture } from "astro:assets"
import { getCollection, render } from "astro:content"
import type { GetStaticPaths } from "astro"

import { categoryLabel, type CategorySlug } from "../../lib/categories"
import {
  LATER_PHOTO,
  openingSizes,
  OPENING_PHOTO,
  PHOTO,
  sequenceSizes,
} from "../../lib/images"
import { toScreens } from "../../lib/sequence"
import Layout from "../../layouts/Layout.astro"

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects")

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }))
}) satisfies GetStaticPaths

const { project } = Astro.props
const { Content } = await render(project)
const d = project.data

const facts = [
  {
    label: "Projeto",
    lines: (d.categories as CategorySlug[]).map(categoryLabel),
  },
  { label: "Local", lines: [d.location] },
  ...(d.area ? [{ label: "m²", lines: [String(d.area)] }] : []),
  { label: "Ano", lines: [String(d.year)] },
]

const screens = toScreens(d.images)

/** The photograph the page opens on, announced in the head. */
const openingPhoto = { src: d.cover, sizes: openingSizes(d.cover, 1.06) }
---

<Layout openingPhoto={openingPhoto} title={d.title} description={d.summary}>
  <article>
    <figure class="opening">
      <Picture
        src={d.cover}
        alt={d.coverAlt}
        sizes={openingPhoto.sizes}
        {...PHOTO}
        {...OPENING_PHOTO}
        transition:name={`cover-${project.id}`}
      />
      <figcaption>
        <h1>{d.title}</h1>
        <dl class="facts">
          {
            facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                {fact.lines.map((line) => (
                  <dd>{line}</dd>
                ))}
              </div>
            ))
          }
        </dl>
      </figcaption>
    </figure>

    <section class="story">
      <div class="prose" data-reveal><Content /></div>
    </section>

    {
      screens.map((screen) => (
        <div class="screen">
          {screen.map(({ item, ratio }) => (
            <figure style={`--ratio: ${ratio}`} data-reveal="clip">
              <Picture
                src={item.src}
                alt={item.alt}
                sizes={sequenceSizes(item.src, ratio)}
                {...PHOTO}
                {...LATER_PHOTO}
              />
            </figure>
          ))}
        </div>
      ))
    }
  </article>
</Layout>

<style>
  /* Every screen of this page is one grid row tall, so the page moves a
     photograph at a time, exactly like the home page. */
  article {
    --screen: calc(100svh - var(--header-height) - var(--edge));
    display: flex;
    flex-direction: column;
    gap: var(--edge);
  }

  /* ------------------------------------------------------------- opening */
  .opening {
    position: relative;
    margin: 0;
    overflow: clip;
    background: var(--color-grey-2);
  }

  .opening img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    animation: settle 12s var(--ease-out-soft) forwards;
  }

  @keyframes settle {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  .opening figcaption {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-7) clamp(1rem, 2.7vw, 3.25rem) var(--edge);
    color: #fff;
    /* Just enough shading to hold the words over a pale photograph. */
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.5);
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.35) 0%,
      rgb(0 0 0 / 0) 100%
    );
  }

  h1 {
    font-size: clamp(1.5rem, 1.875vw, 2.25rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) clamp(1rem, 2.6vw, 3.125rem);
    margin: 0;
    font-size: var(--text-ui);
    line-height: 1.35;
  }

  dt {
    font-weight: 700;
  }

  dd {
    margin: 0;
  }

  /* --------------------------------------------------------------- story */
  .story {
    display: grid;
    place-items: center;
    padding-inline: var(--gutter);
  }

  .prose {
    max-inline-size: var(--measure);
    font-size: var(--text-ui);
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* The base layer caps paragraph width; the column is the measure here. */
  .prose :global(p) {
    max-inline-size: none;
  }

  .prose :global(p + p) {
    margin-block-start: 1.6em;
  }

  /* ----------------------------------------------------------- sequence */
  .screen {
    display: flex;
    flex-direction: column;
    gap: var(--edge);
  }

  /* Her standing rule: nothing is ever written over these photographs. There
     is no caption here and no field to put one in — only the opening
     photograph at the top of the page carries words. */
  .screen figure {
    margin: 0;
    overflow: clip;
    background: var(--color-grey-2);
  }

  .screen img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* On the phone everything is simply full width, one under the other. */
  .opening,
  .screen figure {
    block-size: auto;
  }

  .opening img,
  .screen img {
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 60rem) {
    .opening,
    .screen {
      block-size: var(--screen);
    }

    /* A screenful when the text fits, taller when it does not, so a long
       description never slides up under the menu band. */
    .story {
      min-block-size: var(--screen);
      padding-block: var(--edge);
    }

    .opening img,
    .screen img {
      aspect-ratio: auto;
    }

    .screen {
      flex-direction: row;
      align-items: stretch;
      justify-content: center;
    }

    .screen figure {
      inline-size: calc(var(--screen) * var(--ratio));
      block-size: 100%;
    }

    /* Justified only once the column is wide enough not to gap badly. */
    .prose {
      text-align: justify;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .opening img {
      animation: none;
    }
  }
</style>
