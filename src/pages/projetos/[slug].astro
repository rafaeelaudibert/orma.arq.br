---
import { Image } from "astro:assets"
import { getCollection, render } from "astro:content"
import type { GetStaticPaths } from "astro"

import { categoryLabel, type CategorySlug } from "../../lib/categories"
import { openingSizes, PHOTO_WIDTHS, sequenceSizes } from "../../lib/images"
import { toScreens } from "../../lib/sequence"
import Layout from "../../layouts/Layout.astro"

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects")

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }))
}) satisfies GetStaticPaths

const { project } = Astro.props
const { Content } = await render(project)
const d = project.data

const facts = [
  {
    label: "Projeto",
    lines: (d.categories as CategorySlug[]).map(categoryLabel),
  },
  { label: "Local", lines: [d.location] },
  ...(d.area ? [{ label: "m²", lines: [String(d.area)] }] : []),
  { label: "Ano", lines: [String(d.year)] },
]

const screens = toScreens(d.images)
---

<Layout title={d.title} description={d.summary} flush>
  <article>
    <figure class="opening">
      <Image
        src={d.cover}
        alt={d.coverAlt}
        widths={PHOTO_WIDTHS}
        sizes={openingSizes(d.cover, 1.06)}
        loading="eager"
        fetchpriority="high"
        transition:name={`cover-${project.id}`}
      />
      <figcaption>
        <h1>{d.title}</h1>
        <dl class="facts">
          {
            facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                {fact.lines.map((line) => (
                  <dd>{line}</dd>
                ))}
              </div>
            ))
          }
        </dl>
      </figcaption>
    </figure>

    <section class="story">
      <div class="prose" data-reveal><Content /></div>
    </section>

    {
      screens.map(({ photos, sum }) => (
        <div class="screen" style={`--sum: ${sum}`}>
          {photos.map(({ item, ratio }) => (
            <figure style={`--ratio: ${ratio}`} data-reveal="clip">
              <Image
                src={item.src}
                alt={item.alt}
                widths={PHOTO_WIDTHS}
                sizes={sequenceSizes(item.src, sum)}
              />
            </figure>
          ))}
        </div>
      ))
    }
  </article>
</Layout>

<style>
  /* Every screen of this page is one grid row tall, so the page moves a
     photograph at a time, exactly like the home page. */
  article {
    --screen: calc(100svh - var(--header-height) - var(--edge));
    display: flex;
    flex-direction: column;
    gap: var(--edge);
  }

  /* ------------------------------------------------------------- opening */
  .opening {
    position: relative;
    margin: 0;
    overflow: clip;
    background: var(--color-grey-2);
  }

  .opening img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    animation: settle 12s var(--ease-out-soft) forwards;
  }

  @keyframes settle {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  .opening figcaption {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-7) clamp(1rem, 2.7vw, 3.25rem) var(--edge);
    color: #fff;
    /* Just enough shading to hold the words over a pale photograph. */
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.5);
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.35) 0%,
      rgb(0 0 0 / 0) 100%
    );
  }

  h1 {
    font-size: clamp(1.5rem, 1.875vw, 2.25rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) clamp(1rem, 2.6vw, 3.125rem);
    margin: 0;
    font-size: var(--text-ui);
    line-height: 1.35;
  }

  dt {
    font-weight: 700;
  }

  dd {
    margin: 0;
  }

  /* --------------------------------------------------------------- story */
  .story {
    display: grid;
    place-items: center;
    padding-inline: var(--gutter);
  }

  .prose {
    max-inline-size: 56rem;
    font-size: var(--text-ui);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .prose :global(p + p) {
    margin-block-start: 1.6em;
  }

  /* ----------------------------------------------------------- sequence
     Photographs are shown whole: every box carries its own photograph's
     proportions, so nothing is ever cropped and no information is lost. */
  .screen {
    display: flex;
    flex-direction: column;
    gap: var(--edge);
  }

  .screen figure {
    margin: 0;
    background: var(--color-grey-2);
  }

  .screen img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: var(--ratio);
  }

  /* Under the photograph, never over it. */
  /* On the phone everything is simply full width, one under the other. */
  .opening {
    block-size: auto;
  }

  .opening img {
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 60rem) {
    .opening,
    .story {
      block-size: var(--screen);
    }

    .opening img {
      aspect-ratio: auto;
    }

    /* A row is a grid row tall, unless the column is too narrow to hold it at
       that size, in which case the whole row scales down together. The width
       has to be definite: the photographs inside are laid out from it, and an
       `auto` width would collapse around them instead. */
    .screen {
      flex-direction: row;
      align-items: flex-start;
      align-self: center;
      inline-size: min(100%, calc(var(--screen) * var(--sum)));
    }

    .screen figure {
      flex: var(--ratio) 1 0;
      min-inline-size: 0;
    }

    /* Justified only once the column is wide enough not to gap badly. */
    .prose {
      text-align: justify;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .opening img {
      animation: none;
    }
  }
</style>
