---
import { Image } from "astro:assets"

import photo from "../assets/projects/apartamento-br/01-bedroom.jpg"
import { studio, whatsappUrl } from "../config"
import { PHOTO_WIDTHS, sequenceSizes } from "../lib/images"
import Layout from "../layouts/Layout.astro"

/** The same share of the screen height as a pair of photographs elsewhere. */
const RATIO = 0.764
---

<Layout
  title="Contato"
  description={`Fale com a ${studio.name}. Projetos de arquitetura e interiores em ${studio.regions.join(" e ")}. Converse pelo WhatsApp ou por e-mail.`}
  flush
>
  <h1 class="visually-hidden">Contato — {studio.name}</h1>

  <section class="pair" style={`--ratio: ${RATIO}`}>
    <figure>
      <Image
        src={photo}
        alt="Quarto de casal com painel de madeira escura, cabeceira estofada azul e luminária de papel sobre a cama"
        widths={PHOTO_WIDTHS}
        sizes={sequenceSizes(photo, RATIO)}
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    <div class="details" data-reveal>
      <p class="lead">Vamos conversar?</p>
      <p class="lead">Entre em contato através do WhatsApp ou por e-mail.</p>

      <ul role="list">
        <li><a href={`mailto:${studio.email}`}>{studio.email}</a></li>
        <li>
          <a href={studio.instagram} rel="noopener">{studio.instagramHandle}</a>
        </li>
        <li>
          <a href={whatsappUrl} rel="noopener">chame pelo WhatsApp</a>
          <span class="hours"> (de segunda a sexta-feira, das 9h às 18h) </span>
        </li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .pair {
    --screen: calc(100svh - var(--header-height) - var(--edge));
    display: flex;
    flex-direction: column;
    gap: var(--edge);
  }

  figure {
    margin: 0;
    overflow: clip;
    background: var(--color-grey-2);
  }

  figure img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .details {
    padding-inline: var(--gutter);
    font-size: var(--text-ui);
    line-height: 1.45;
  }

  .lead {
    font-weight: 700;
  }

  .lead + .lead {
    margin-block-start: 1.35em;
  }

  ul {
    margin: 1.35em 0 0;
    padding: 0;
  }

  .hours {
    color: var(--color-grey-1);
  }

  a {
    position: relative;
  }

  /* The underline draws in on hover, as it does in the menu and the footer. */
  a::after {
    content: "";
    position: absolute;
    inset-block-end: -0.1em;
    inset-inline: 0;
    block-size: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-fast) var(--ease-out-soft);
  }

  a:hover::after,
  a:focus-visible::after {
    transform: scaleX(1);
  }

  @media (min-width: 60rem) {
    .pair {
      flex-direction: row;
      align-items: stretch;
      justify-content: center;
      block-size: var(--screen);
    }

    figure {
      inline-size: calc(var(--screen) * var(--ratio));
    }

    figure img {
      aspect-ratio: auto;
    }

    .details {
      display: flex;
      flex-direction: column;
      justify-content: center;
      inline-size: calc(var(--screen) * var(--ratio));
      padding-inline: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a::after {
      transition: none;
    }
  }
</style>
