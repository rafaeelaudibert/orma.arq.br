---
import { getCollection } from "astro:content"
import type { GetStaticPaths } from "astro"

import ProjectGrid from "../components/ProjectGrid.astro"
import { studio } from "../config"
import { categories } from "../lib/categories"
import Layout from "../layouts/Layout.astro"

export const getStaticPaths = (async () => {
  const projects = (await getCollection("projects")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  )

  return categories.map((category) => ({
    params: { category: category.slug },
    props: {
      category,
      projects: projects.filter((p) =>
        (p.data.categories as string[]).includes(category.slug),
      ),
    },
  }))
}) satisfies GetStaticPaths

const { category, projects } = Astro.props
---

<Layout
  title={category.label}
  description={`${category.intro} Projetos de ${category.label.toLowerCase()} do estúdio ${studio.name}, em ${studio.regions.join(" e ")}.`}
  flush
>
  <header class="intro">
    <h1>{category.label}</h1>
    <p>{category.intro}</p>
  </header>

  {
    projects.length > 0 ? (
      <ProjectGrid projects={projects} lead={false} />
    ) : (
      <p class="empty">Estamos preparando esta seção. Volte em breve.</p>
    )
  }
</Layout>

<style>
  /* A quiet section heading at the top of the content column, so the page has
     a name without competing with the photographs. */
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-4) var(--space-5);
  }

  h1 {
    font-size: clamp(1.75rem, 3.4vw, 3.25rem);
    font-weight: 300;
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
  }

  .intro p {
    max-inline-size: 34rem;
    color: var(--color-grey-1);
    font-size: var(--text-ui);
    line-height: 1.5;
  }

  .empty {
    padding-block-end: var(--space-7);
    color: var(--color-grey-1);
  }
</style>
