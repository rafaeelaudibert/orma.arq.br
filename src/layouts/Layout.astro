---
import Footer from "../components/Footer.astro"
import PostHog from "../components/posthog.astro"
import SiteNav from "../components/SiteNav.astro"
import { studio } from "../config"
import "../styles/global.css"

interface Props {
  /** Page name; the studio name is appended automatically. */
  title?: string
  description: string
  /** Pages whose first screen is an image start flush against the top. */
  flush?: boolean
}

const { title, description, flush = false } = Astro.props

const pageTitle = title ? `${title} — ${studio.name}` : studio.name
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-512.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <meta name="theme-color" content="#f7f6f4" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, studio.url)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={studio.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />

    <PostHog />
  </head>

  <body>
    <SiteNav overlay={flush} />

    <main id="conteudo" class:list={[{ flush }]}>
      <slot />
    </main>

    <Footer />

    <script src="../scripts/motion.js"></script>
  </body>
</html>

<style>
  main:not(.flush) {
    padding: var(--section-pad) var(--gutter) 0;
  }
</style>
