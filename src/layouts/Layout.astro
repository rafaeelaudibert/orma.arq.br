---
import Footer from "../components/Footer.astro"
import PostHog from "../components/posthog.astro"
import { getImage } from "astro:assets"
import { ClientRouter } from "astro:transitions"
import SiteNav from "../components/SiteNav.astro"
import { studio } from "../config"
import { PHOTO } from "../lib/images"
import type { ImageMetadata } from "astro"
import "../styles/global.css"

interface Props {
  /** Page name; the studio name is appended automatically. */
  title?: string
  description: string
  /**
   * The photograph this page opens on, when it has one above the fold. It is
   * announced in the <head> so the browser starts fetching it as the page
   * arrives, instead of waiting until it has parsed and styled its way down to
   * the picture itself — on a portfolio that is the difference between the
   * first screen appearing and the first screen appearing a beat later.
   */
  openingPhoto?: { src: ImageMetadata; sizes: string }
}

const { title, description, openingPhoto } = Astro.props

const pageTitle = title ? `${title} — ${studio.name}` : studio.name

/**
 * Asking for the same widths and format the picture itself asks for, so the
 * browser is handed the identical set of files and picks the identical one —
 * a preload that doesn't match is a whole photograph downloaded twice.
 *
 * Only the modern format is announced. Browsers that can't read it skip a
 * preload carrying a `type` they don't support and simply find the fallback
 * the ordinary way, which is what they did before.
 */
const preload = openingPhoto
  ? await getImage({
      src: openingPhoto.src,
      widths: PHOTO.widths,
      format: PHOTO.formats[0],
    })
  : undefined
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <meta name="theme-color" content="#f7f6f4" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    {
      preload && (
        <link
          rel="preload"
          as="image"
          type={`image/${PHOTO.formats[0]}`}
          imagesrcset={preload.srcSet.attribute}
          imagesizes={openingPhoto!.sizes}
          fetchpriority="high"
        />
      )
    }
    <link rel="canonical" href={new URL(Astro.url.pathname, studio.url)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={studio.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />

    <PostHog />

    {/* Lets a project photograph fly from the grid into its own page. */}
    <ClientRouter />
  </head>

  <body>
    <SiteNav />

    <main id="conteudo">
      <slot />
    </main>

    <Footer />

    <script src="../scripts/motion.js"></script>
  </body>
</html>

<style>
  /* The right-hand column, and the only one there is: every page sits to the
     right of the rail with the sideways logo, starts under the menu band, and
     runs to the same thin margin on the other side. One structure for all of
     them, so the menu above is centred on every page alike; a page that wants
     a narrower measure centres its own text inside this column rather than
     moving the column. */
  @media (min-width: 60rem) {
    main {
      margin-inline-start: var(--rail-width);
      padding-block-start: var(--header-height);
      padding-inline-end: var(--edge);
    }
  }
</style>
