---
import type { CollectionEntry } from "astro:content"

import { toRows } from "../lib/grid"
import ProjectTile from "./ProjectTile.astro"

interface Props {
  projects: CollectionEntry<"projects">[]
  /** The newest project gets the full column to itself. Off on filtered pages. */
  lead?: boolean
}

const { projects, lead = true } = Astro.props
const rows = toRows(projects, { lead })

let tileIndex = 0
---

<div class="grid">
  {
    rows.map((row, rowIndex) => (
      <div class:list={["row", { lead: lead && rowIndex === 0 }]}>
        {row.cells.map((cell) => (
          <ProjectTile
            project={cell.item}
            span={cell.span}
            eager={tileIndex === 0}
            index={tileIndex++ % 3}
          />
        ))}
      </div>
    ))
  }
</div>

<style>
  .grid {
    display: flex;
    flex-direction: column;
    gap: var(--edge);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--edge);
  }

  /* On the phone every project gets the same generous slice of the screen. */
  .row :global(.tile figure) {
    aspect-ratio: 4 / 3;
  }

  /* The opening project keeps the page margin below it, which is exactly the
     gap to the next row, so only the big photograph shows until you scroll. */
  .row.lead {
    block-size: calc(100svh - var(--header-flow) - var(--edge));
  }

  .row.lead :global(.tile figure) {
    aspect-ratio: auto;
  }

  @media (min-width: 60rem) {
    .row {
      grid-template-columns: repeat(12, 1fr);
      block-size: calc(100svh - var(--header-height) - var(--edge));
    }

    .row.lead {
      block-size: calc(100svh - var(--header-height) - var(--edge));
    }

    .row :global(.tile figure) {
      aspect-ratio: auto;
    }
  }
</style>
