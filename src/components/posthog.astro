---
// PostHog analytics initialization for this static site.
---

<script
  is:inline
  define:vars={{
    projectToken: import.meta.env.PUBLIC_POSTHOG_PROJECT_TOKEN,
    apiHost: import.meta.env.PUBLIC_POSTHOG_HOST,
  }}
>
  if (projectToken && apiHost) {
    import("posthog-js").then(({ default: posthog }) => {
      posthog.init(projectToken, {
        api_host: apiHost,
        defaults: "2026-01-30",
      })
    })
  }
</script>
