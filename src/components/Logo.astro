---
import Wordmark from "../assets/brand/logo.svg"

/**
 * The Orma wordmark, drawn in the studio's own typeface.
 * The SVG paints with `currentColor`, so the colour comes from whoever uses it.
 */
---

<Wordmark class="logo" role="img" aria-label="Orma Arquitetura" />

<style>
  .logo {
    inline-size: var(--logo-width, 7.5rem);
    max-inline-size: 100%;
    block-size: auto;
    color: var(--color-ink);
  }
</style>
