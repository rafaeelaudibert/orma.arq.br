---
import { navLinks } from "../lib/categories"
import Logo from "./Logo.astro"

interface Props {
  /**
   * True on pages that open with a full-screen image: the block then floats
   * over the photograph instead of pushing the page down.
   */
  overlay?: boolean
}

const { overlay = false } = Astro.props

/** Current path without a trailing slash, so /arquitetura/ matches /arquitetura. */
const here = Astro.url.pathname.replace(/\/+$/, "") || "/"
const isCurrent = (href: string) => here === href
---

<header class="menu" class:list={[{ overlay }]}>
  <a
    class="brand"
    href="/"
    aria-label="Orma Arquitetura, ir para a página inicial"
  >
    <Logo />
  </a>

  <nav aria-label="Navegação principal">
    <ul role="list">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .menu {
    position: relative;
    z-index: 20;
    display: flex;
    flex-direction: column;
    justify-content: center;
    inline-size: var(--menu-width);
    min-block-size: var(--menu-height);
    padding: var(--space-4) var(--space-3);
    background: var(--color-paper);
    text-align: center;
  }

  .menu.overlay {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
  }

  .brand {
    display: flex;
    justify-content: center;
    padding-block-end: var(--space-4);
    --logo-width: 6.5rem;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
  }

  li a {
    display: grid;
    place-items: center;
    /* Comfortable to tap without making the block tower over the photograph. */
    min-block-size: 2.25rem;
    font-size: var(--text-body);
    line-height: 1.2;
    color: var(--color-grey-1);
    transition: color var(--motion-fast) var(--ease-out-soft);
  }

  li a[aria-current="page"],
  li a:hover,
  li a:focus-visible {
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    li a {
      transition: none;
    }
  }
</style>
