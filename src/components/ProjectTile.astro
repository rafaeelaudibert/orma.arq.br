---
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"

import { PHOTO_WIDTHS, tileSizes } from "../lib/images"

interface Props {
  project: CollectionEntry<"projects">
  /** Share of the 12-column row this tile occupies. */
  span: number
  /** True for the first tile on the page, which must not lazy-load. */
  eager?: boolean
  index?: number
  /** The opening tile, which is sized against the screen rather than the grid. */
  lead?: boolean
}

const { project, span, eager = false, index = 0, lead = false } = Astro.props
const { title, cover, coverAlt, location } = project.data

const sizes = tileSizes(cover, span, lead)
---

<a
  class="tile"
  href={`/projetos/${project.id}`}
  style={`--span: ${span}; --stagger: ${index}`}
  data-reveal={eager ? undefined : ""}
>
  <figure>
    <Image
      src={cover}
      alt={coverAlt}
      widths={PHOTO_WIDTHS}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      transition:name={`cover-${project.id}`}
    />
    <figcaption>
      <span class="title">{title}</span>
      <span class="place">{location}</span>
    </figcaption>
  </figure>
</a>

<style>
  .tile {
    grid-column: span var(--span);
    display: block;
    /* Let the row height win over the photograph's own proportions. */
    min-inline-size: 0;
    min-block-size: 0;
    block-size: 100%;
    overflow: clip;
  }

  figure {
    position: relative;
    block-size: 100%;
    overflow: clip;
    background: var(--color-grey-2);
  }

  img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform 900ms var(--ease-out-soft);
  }

  .tile:hover img,
  .tile:focus-visible img {
    transform: scale(1.04);
  }

  figcaption {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    display: flex;
    flex-direction: column;
    padding: var(--space-5) var(--space-3) clamp(1.25rem, 2.76vw, 3.3125rem);
    color: #fff;
    font-size: var(--text-ui);
    line-height: 1.35;
    text-align: center;
    /* The design puts the words straight on the photograph. A whisper of
       shading plus a soft shadow keeps them readable over a pale one. */
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.5);
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.3) 0%,
      rgb(0 0 0 / 0) 100%
    );
    pointer-events: none;
  }

  .title {
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    img,
    .tile:hover img,
    .tile:focus-visible img {
      transition: none;
      transform: none;
    }
  }
</style>
