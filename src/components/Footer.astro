---
import { partnerNames, studio } from "../config"

/**
 * The footer from the Figma design: the studio and its architects on the left,
 * how to reach them on the right, and the year centred underneath. It shares
 * the last screen with the final row of photographs.
 */

const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="columns">
    <section>
      <h2>{studio.name}</h2>
      <p class="label">Arquitetas</p>
      <ul role="list">
        {partnerNames.map((name) => <li>{name}</li>)}
      </ul>
    </section>

    <section>
      <h2>Contato</h2>
      <ul role="list">
        <li><a href={`mailto:${studio.email}`}>{studio.email}</a></li>
        <li>
          <a href={studio.instagram} rel="noopener">{studio.instagramHandle}</a>
        </li>
      </ul>
    </section>
  </div>

  <p class="colophon">{year} {studio.name}</p>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6) var(--edge) var(--space-5);
    font-size: var(--text-ui);
    line-height: 1.45;
  }

  .columns {
    display: grid;
    gap: var(--space-5);
  }

  h2 {
    font-size: inherit;
    font-weight: 600;
  }

  .label {
    margin-block-start: 1.35em;
  }

  ul {
    margin: 1.35em 0 0;
    padding: 0;
  }

  section a {
    position: relative;
  }

  /* The underline draws in on hover, as it does in the menu. */
  section a::after {
    content: "";
    position: absolute;
    inset-block-end: -0.1em;
    inset-inline: 0;
    block-size: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-fast) var(--ease-out-soft);
  }

  section a:hover::after,
  section a:focus-visible::after {
    transform: scaleX(1);
  }

  .colophon {
    color: var(--color-mute);
    font-weight: 600;
    text-align: center;
  }

  @media (min-width: 60rem) {
    .footer {
      justify-content: space-between;
      /* Fixed, so the last row of photographs and the footer always add up to
         exactly one screen. */
      block-size: calc(var(--footer-height) + 2 * var(--edge));
      margin-inline-start: var(--rail-width);
      padding: var(--edge) var(--edge) var(--edge) 0;
    }

    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--edge);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    section a::after {
      transition: none;
    }
  }
</style>
