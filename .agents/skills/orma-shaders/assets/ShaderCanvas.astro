---
// Full-bleed animated WebGL background with normal HTML content on top.
// Managed by the `orma-shaders` skill — see it for recipes and rules.
//
// Uniforms available inside the fragment shader:
//   uniform float u_time;        // seconds since load
//   uniform vec2  u_resolution;  // canvas size in physical pixels
//   uniform vec2  u_mouse;       // pointer position, 0..1 each axis, smoothed
//
// If WebGL is unavailable the `fallback` CSS background shows instead.
// If the visitor prefers reduced motion, one static frame is drawn.
interface Props {
  /** GLSL fragment shader source — import a .glsl file with `?raw` */
  frag: string;
  /** CSS background shown when WebGL is unavailable */
  fallback?: string;
  class?: string;
}
const {
  frag,
  fallback = 'linear-gradient(#101014, #1c1c22)',
  class: className,
} = Astro.props;
---

<div class:list={['shader-scene', className]} data-shader-scene>
  <canvas aria-hidden="true" style={`background: ${fallback}`}></canvas>
  <script is:inline type="text/x-fragment-shader" set:html={frag} />
  <div class="content"><slot /></div>
</div>

<style>
  .shader-scene {
    position: relative;
    isolation: isolate;
  }
  canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    display: block;
  }
  .content {
    position: relative;
  }
</style>

<script>
  const VERTEX = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function boot(scene: Element) {
    const canvas = scene.querySelector('canvas');
    const source = scene.querySelector(
      'script[type="text/x-fragment-shader"]'
    )?.textContent;
    if (!canvas || !source) return;

    const gl = canvas.getContext('webgl', {
      alpha: false,
      antialias: false,
      powerPreference: 'low-power',
    });
    if (!gl) return; // the CSS fallback background stays visible

    let uTime: WebGLUniformLocation | null = null;
    let uResolution: WebGLUniformLocation | null = null;
    let uMouse: WebGLUniformLocation | null = null;

    const compile = (type: number, src: string) => {
      const shader = gl.createShader(type)!;
      gl.shaderSource(shader, src);
      gl.compileShader(shader);
      if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
        console.error(
          '[ShaderCanvas] shader compile error:\n' + gl.getShaderInfoLog(shader)
        );
        return null;
      }
      return shader;
    };

    // (Re)creates every GPU resource. Called once at start and again
    // whenever the browser restores a lost context.
    const setup = () => {
      const vs = compile(gl.VERTEX_SHADER, VERTEX);
      const fs = compile(gl.FRAGMENT_SHADER, source);
      if (!vs || !fs) return false;

      const program = gl.createProgram()!;
      gl.attachShader(program, vs);
      gl.attachShader(program, fs);
      gl.linkProgram(program);
      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
        console.error(
          '[ShaderCanvas] program link error:\n' + gl.getProgramInfoLog(program)
        );
        return false;
      }
      gl.useProgram(program);

      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(
        gl.ARRAY_BUFFER,
        new Float32Array([-1, -1, 3, -1, -1, 3]),
        gl.STATIC_DRAW
      );
      const position = gl.getAttribLocation(program, 'p');
      gl.enableVertexAttribArray(position);
      gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);

      uTime = gl.getUniformLocation(program, 'u_time');
      uResolution = gl.getUniformLocation(program, 'u_resolution');
      uMouse = gl.getUniformLocation(program, 'u_mouse');
      gl.viewport(0, 0, canvas.width, canvas.height);
      return true;
    };
    if (!setup()) return;

    let mouseX = 0.5;
    let mouseY = 0.5;
    let targetX = 0.5;
    let targetY = 0.5;
    scene.addEventListener('pointermove', (e) => {
      const rect = scene.getBoundingClientRect();
      targetX = ((e as PointerEvent).clientX - rect.left) / rect.width;
      targetY = 1 - ((e as PointerEvent).clientY - rect.top) / rect.height;
    });

    const draw = (time: number) => {
      gl.uniform1f(uTime, time);
      gl.uniform2f(uResolution, canvas.width, canvas.height);
      gl.uniform2f(uMouse, mouseX, mouseY);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };

    let dead = false; // true while the WebGL context is lost
    let visible = false;
    let raf = 0;
    const start = performance.now();
    const frame = (now: number) => {
      raf = 0;
      if (!visible || dead) return;
      mouseX += (targetX - mouseX) * 0.06;
      mouseY += (targetY - mouseY) * 0.06;
      draw((now - start) / 1000);
      raf = requestAnimationFrame(frame);
    };

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const resize = () => {
      const w = Math.round(canvas.clientWidth * dpr);
      const h = Math.round(canvas.clientHeight * dpr);
      if ((w === canvas.width && h === canvas.height) || dead) return;
      canvas.width = w;
      canvas.height = h;
      gl.viewport(0, 0, w, h);
      if (reduced) draw(10); // keep the frozen frame crisp after resizes
    };
    new ResizeObserver(resize).observe(canvas);
    resize();

    canvas.addEventListener('webglcontextlost', (e) => {
      e.preventDefault(); // signal that we will handle the restore
      dead = true;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    });
    canvas.addEventListener('webglcontextrestored', () => {
      if (!setup()) return;
      dead = false;
      if (reduced) {
        draw(10);
      } else if (visible && !raf) {
        raf = requestAnimationFrame(frame);
      }
    });

    if (reduced) {
      draw(10); // a single static frame, refreshed only on resize
      return;
    }

    // Only render while on screen, so a hero and a footer never animate at once.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !dead && !raf) raf = requestAnimationFrame(frame);
    }).observe(canvas);
  }

  document.querySelectorAll('[data-shader-scene]').forEach(boot);
</script>
